{
  "name": "flightplotter",
  "version": "0.4.1",
  "description": "Synchronized time-series and 3D craft plots for flight logs in the browser (uPlot + three.js), the JS side of pyFlightPlotter",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "Till Blaha <t.m.blaha@tudelft.nl>",
  "repository": { "type": "git", "url": "https://github.com/tudelft/pyFlightPlotter" },
  "main": "./pyFlightPlotter/web/static/flightplotter/index.js",
  "exports": {
    ".": "./pyFlightPlotter/web/static/flightplotter/index.js",
    "./style.css": "./pyFlightPlotter/web/static/flightplotter/style.css"
  },
  "files": [
    "pyFlightPlotter/web/static/flightplotter/"
  ],
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "uplot": "^1.6.32"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  }
}
